### `Economic Security Selector`

```dax
Economic Security Selector = ROW("_placeholder", 0)
```

Add this measure to `Economic Security Selector`:

```dax
Selected Economic Breakdown =
VAR _type  = SELECTEDVALUE(dim_economic_category[category_type])
VAR _label = SELECTEDVALUE(dim_economic_category[category_label])

RETURN
SWITCH(
    TRUE(),

    -- Poverty Rate (B17001) ----------------------------------------------------
    -- _001 = total universe, _002 = total below poverty
    -- _003 = Male below poverty (total), _017 = Female below poverty (total)
    -- _032 = Male at or above poverty,   _046 = Female at or above poverty
    _type = "Poverty Rate" && _label = "Overall",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001_001")
        ),

    _type = "Poverty Rate" && _label = "Women",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001_017"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN { "B17001_017", "B17001_046" })
        ),

    _type = "Poverty Rate" && _label = "Men",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001_003"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN { "B17001_003", "B17001_032" })
        ),

    -- Poverty Rate by Race (B17001A-I) -----------------------------------------
    -- _002 = below poverty, _001 = total for that race group
    _type = "Poverty Rate by Race" && _label = "White",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001A_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001A_001")
        ),

    _type = "Poverty Rate by Race" && _label = "Black or African American",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001B_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001B_001")
        ),

    _type = "Poverty Rate by Race" && _label = "American Indian or Alaska Native",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001C_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001C_001")
        ),

    _type = "Poverty Rate by Race" && _label = "Asian",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001D_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001D_001")
        ),

    _type = "Poverty Rate by Race" && _label = "Hispanic or Latino",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001I_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001I_001")
        ),

    -- Housing Tenure (B25003) --------------------------------------------------
    -- _001 = total occupied units, _002 = owner-occupied, _003 = renter-occupied
    _type = "Housing Tenure" && _label = "Owner-Occupied",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25003_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25003_001")
        ),

    _type = "Housing Tenure" && _label = "Renter-Occupied",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25003_003"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25003_001")
        ),

    -- Rent Burden (B25070) -----------------------------------------------------
    -- _001 = total renter-occupied units with cash rent (denominator)
    -- _002 = <10%, _003 = 10-14.9%, _004 = 15-19.9%, _005 = 20-24.9%  → less than 25%
    -- _006 = 25-29.9%
    -- _007 = 30-34.9%
    -- _008 = 35-39.9%, _009 = 40-49.9%, _010 = 50%+ → 35% or more
    _type = "Rent Burden" && _label = "Less than 25% of Income",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN {
                    "B25070_002","B25070_003","B25070_004","B25070_005"
                }),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25070_001")
        ),

    _type = "Rent Burden" && _label = "25–29.9%",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25070_006"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25070_001")
        ),

    _type = "Rent Burden" && _label = "30–34.9%",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25070_007"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25070_001")
        ),

    _type = "Rent Burden" && _label = "35% or More",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN {
                    "B25070_008","B25070_009","B25070_010"
                }),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B25070_001")
        ),

    -- SNAP Recipiency (B22010, B22002) -----------------------------------------
    -- B22010_001 = total households, B22010_002 = HH receiving SNAP
    -- B22002: female-headed no-spouse HH: _006 = receiving SNAP, _007 = not receiving
    --         male-headed no-spouse HH:   _012 = receiving SNAP, _013 = not receiving
    _type = "SNAP Recipiency" && _label = "Any Household Receiving SNAP",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B22010_002"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B22010_001")
        ),

    _type = "SNAP Recipiency" && _label = "Female-Headed Household",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B22002_006"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN { "B22002_006", "B22002_007" })
        ),

    _type = "SNAP Recipiency" && _label = "Male-Headed Household",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B22002_012"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN { "B22002_012", "B22002_013" })
        ),

    BLANK()
)
```


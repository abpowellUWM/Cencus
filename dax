### `Employment Selector`

```dax
Employment Selector = ROW("_placeholder", 0)
```

Then add this measure to `Employment Selector`:

```dax
Selected Employment Breakdown =
VAR _type  = SELECTEDVALUE(dim_employment_category[category_type])
VAR _label = SELECTEDVALUE(dim_employment_category[category_label])

-- Female "in labor force" rows across age groups (B23001)
-- Each pair pulled by asc.py is (age-group total, in-LF total)
-- Odd-index of each pair = in LF: 089, 096, 103, 110, 117, 124, 131, 138, 145, 152, 159, 166, 173
VAR _femLF = {
    "B23001_089","B23001_096","B23001_103","B23001_110","B23001_117",
    "B23001_124","B23001_131","B23001_138","B23001_145","B23001_152",
    "B23001_159","B23001_166","B23001_173"
}
-- Male "in labor force" rows: 004, 011, 018, 025, 032, 039, 046, 053, 060, 067, 074, 081
VAR _maleLF = {
    "B23001_004","B23001_011","B23001_018","B23001_025","B23001_032",
    "B23001_039","B23001_046","B23001_053","B23001_060","B23001_067",
    "B23001_074","B23001_081"
}

RETURN
SWITCH(
    TRUE(),

    -- Labor Force Participation ------------------------------------------------
    _type = "Labor Force Participation" && _label = "Women",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN _femLF),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B23001_087")
        ),

    _type = "Labor Force Participation" && _label = "Men",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] IN _maleLF),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B23001_002")
        ),

    -- Median Annual Earnings ---------------------------------------------------
    -- B20017: Median earnings for full-time year-round workers 16+
    -- _003 = Male, _006 = Female
    _type = "Median Annual Earnings" && _label = "Women",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017_006"),

    _type = "Median Annual Earnings" && _label = "Men",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017_003"),

    -- Women's Earnings by Race -------------------------------------------------
    -- B20017A-I: race-specific median earnings; _006 = female full-time year-round
    -- A=White, B=Black/AA, C=AIAN, D=Asian, I=Hispanic/Latino
    _type = "Women's Earnings by Race" && _label = "White",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017A_006"),

    _type = "Women's Earnings by Race" && _label = "Black or African American",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017B_006"),

    _type = "Women's Earnings by Race" && _label = "American Indian or Alaska Native",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017C_006"),

    _type = "Women's Earnings by Race" && _label = "Asian",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017D_006"),

    _type = "Women's Earnings by Race" && _label = "Hispanic or Latino",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20017I_006"),

    -- Women's Earnings by Education Level --------------------------------------
    -- B20004: Median earnings by educational attainment, workers 25+
    -- Rows 014-018 = Female breakdowns (002-006 = total, 008-012 = Male)
    _type = "Women's Earnings by Education" && _label = "Less than High School",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20004_014"),

    _type = "Women's Earnings by Education" && _label = "High School Graduate",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20004_015"),

    _type = "Women's Earnings by Education" && _label = "Some College or Associate's",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20004_016"),

    _type = "Women's Earnings by Education" && _label = "Bachelor's Degree",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20004_017"),

    _type = "Women's Earnings by Education" && _label = "Graduate or Professional Degree",
        CALCULATE(SUM(fact_acs_wi_county[estimate]),
            fact_acs_wi_county[var_base] = "B20004_018"),

    BLANK()
)
```


Add this measure to `Race Equity Selector`:

```dax
Selected Race Equity Breakdown =
VAR _type  = SELECTEDVALUE(dim_race_category[category_type])
VAR _label = SELECTEDVALUE(dim_race_category[category_label])

-- C23002A-I: Sex by Age by Employment Status (civilian, 20-64 years) by race
-- Each race table (A-I) has 30 rows. Female "in labor force" rows:
-- In C23002X, the female section starts around row 016.
-- _017 = Female 20-64 total, _018 = Female in labor force (verify row numbers below)
-- Row pattern confirmed by checking dim_variable_raw_2024.csv in outputs/
-- Placeholders — verify these with the verification query at bottom of section:
VAR _femLF_white    = { "C23002A_018" }   -- Female in LF, White alone
VAR _femTot_white   = { "C23002A_017" }   -- Female 20-64 total, White alone
VAR _femLF_black    = { "C23002B_018" }
VAR _femTot_black   = { "C23002B_017" }
VAR _femLF_aian     = { "C23002C_018" }
VAR _femTot_aian    = { "C23002C_017" }
VAR _femLF_asian    = { "C23002D_018" }
VAR _femTot_asian   = { "C23002D_017" }
VAR _femLF_hisp     = { "C23002I_018" }
VAR _femTot_hisp    = { "C23002I_017" }

RETURN
SWITCH(
    TRUE(),

    -- Women's Poverty Rate by Race ---------------------------------------------
    -- B17001X_017 = female below poverty, B17001X_046 = female at or above poverty
    _type = "Women's Poverty Rate" && _label = "White",
        DIVIDE(
            CALCULATE(SUM(fact_acs_wi_county[estimate]),
                fact_acs_wi_county[var_base] = "B17001A_017"),
            CALCULATE(SUM(fact_acs_wi_county[estimate]),

## 5. Core Measures

Add all measures to a dedicated measure table (create an empty table called `_Measures`).

### [Crime_Count]

The primary measure. Works in two contexts:

- **With `dim_demo_axis` on the axis** (bar/column chart): returns the count for
  that specific demographic value, hides bars for the wrong demographic via BLANK().
- **Without `dim_demo_axis` context** (cards, county tables): returns the total
  respecting only the offense and relationship slicers.

```dax
Crime_Count =
VAR _DemoKey     = SELECTEDVALUE(dim_demographic_slicer[DemoKey], "vic_sex")
VAR _AxisValue   = SELECTEDVALUE(dim_demo_axis[DemoValue])
VAR _AxisDemoKey = SELECTEDVALUE(dim_demo_axis[DemoKey])
VAR _OffenseKey  = SELECTEDVALUE(dim_offense_slicer[OffenseKey], "ALL")
VAR _RelKey      = SELECTEDVALUE(dim_relationship_slicer[RelKey], "ALL")
VAR _HasAxis     = NOT ISBLANK(_AxisValue)

-- Intimate partner and family relationship sets
VAR _IPRel = {
    "Victim Was Spouse",
    "Victim Was Common-Law Spouse",
    "Victim was Ex-Spouse",
    "Victim Was Ex-Relationship (Ex-Boyfriend/Girlfriend)",
    "Victim Was Boyfriend/Girlfriend"
}
VAR _FamRel = {
    "Victim Was Child",
    "Victim Was Child of Boyfriend or Girlfriend",
    "Victim Was Parent",
    "Victim Was Stepchild",
    "Victim Was Stepparent",
    "Victim was Foster Parent"
}

-- When we're in a dim_demo_axis row but it belongs to the wrong demographic, hide it
VAR _WrongAxis = _HasAxis && _AxisDemoKey <> _DemoKey

RETURN
IF(
    _WrongAxis,
    BLANK(),
    -- Dispatch: filtered by axis value when present, total when not
    SWITCH(
        TRUE(),

        -- Victim Sex
        _HasAxis && _DemoKey = "vic_sex",
            SWITCH(
                _RelKey,
                "ALL",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_sex] = _AxisValue,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "INTIMATE_PARTNER",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_sex] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _IPRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "FAMILY",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_sex] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _FamRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    )
            ),

        -- Victim Race
        _HasAxis && _DemoKey = "vic_race",
            SWITCH(
                _RelKey,
                "ALL",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_race] = _AxisValue,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "INTIMATE_PARTNER",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_race] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _IPRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "FAMILY",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_race] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _FamRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    )
            ),

        -- Victim Age
        _HasAxis && _DemoKey = "vic_age",
            SWITCH(
                _RelKey,
                "ALL",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_age] = _AxisValue,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "INTIMATE_PARTNER",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_age] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _IPRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "FAMILY",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[vic_age] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _FamRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    )
            ),

        -- Offender Sex
        _HasAxis && _DemoKey = "off_sex",
            SWITCH(
                _RelKey,
                "ALL",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_sex] = _AxisValue,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "INTIMATE_PARTNER",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_sex] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _IPRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "FAMILY",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_sex] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _FamRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    )
            ),

        -- Offender Race
        _HasAxis && _DemoKey = "off_race",
            SWITCH(
                _RelKey,
                "ALL",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_race] = _AxisValue,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "INTIMATE_PARTNER",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_race] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _IPRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "FAMILY",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_race] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _FamRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    )
            ),

        -- Offender Age
        _HasAxis && _DemoKey = "off_age",
            SWITCH(
                _RelKey,
                "ALL",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_age] = _AxisValue,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "INTIMATE_PARTNER",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_age] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _IPRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    ),
                "FAMILY",
                    CALCULATE(SUM(fact_crime_wi_county[estimate]),
                        fact_crime_wi_county[off_age] = _AxisValue,
                        fact_crime_wi_county[relationship] IN _FamRel,
                        IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                    )
            ),

        -- No axis context: return total (used in cards, county-level table)
        SWITCH(
            _RelKey,
            "ALL",
                CALCULATE(SUM(fact_crime_wi_county[estimate]),
                    IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                ),
            "INTIMATE_PARTNER",
                CALCULATE(SUM(fact_crime_wi_county[estimate]),
                    fact_crime_wi_county[relationship] IN _IPRel,
                    IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                ),
            "FAMILY",
                CALCULATE(SUM(fact_crime_wi_county[estimate]),
                    fact_crime_wi_county[relationship] IN _FamRel,
                    IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
                )
        )
    )
)
```


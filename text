## 7. Per-100k County Measure

Requires `dim_county` bridge table (§9). Population variable is `B01003_001E`
(total population) — confirm the `var_base` value matches your ACS table.

```dax
Crime_Per_100k =
VAR _OffenseKey = SELECTEDVALUE(dim_offense_slicer[OffenseKey], "ALL")
VAR _RelKey     = SELECTEDVALUE(dim_relationship_slicer[RelKey], "ALL")
VAR _IPRel = {
    "Victim Was Spouse", "Victim Was Common-Law Spouse",
    "Victim was Ex-Spouse",
    "Victim Was Ex-Relationship (Ex-Boyfriend/Girlfriend)",
    "Victim Was Boyfriend/Girlfriend"
}
VAR _FamRel = {
    "Victim Was Child", "Victim Was Child of Boyfriend or Girlfriend",
    "Victim Was Parent", "Victim Was Stepchild",
    "Victim Was Stepparent", "Victim was Foster Parent"
}

VAR _CrimeCount =
    SWITCH(
        _RelKey,
        "ALL",
            CALCULATE(SUM(fact_crime_wi_county[estimate]),
                IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
            ),
        "INTIMATE_PARTNER",
            CALCULATE(SUM(fact_crime_wi_county[estimate]),
                fact_crime_wi_county[relationship] IN _IPRel,
                IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
            ),
        "FAMILY",
            CALCULATE(SUM(fact_crime_wi_county[estimate]),
                fact_crime_wi_county[relationship] IN _FamRel,
                IF(_OffenseKey <> "ALL", fact_crime_wi_county[metric] = _OffenseKey)
            )
    )

VAR _Population =
    CALCULATE(
        SUM(fact_acs_wi_county[estimate]),
        fact_acs_wi_county[var_base] = "B01003_001E"
    )

RETURN
    IF(
        _Population > 0,
        DIVIDE(_CrimeCount, _Population) * 100000,
        BLANK()
    )
```


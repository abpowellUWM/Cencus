Selected Demo Breakdown =
VAR _metric   = SELECTEDVALUE(dim_dem_crime_category[metric])
VAR _gender   = SELECTEDVALUE(dim_dem_crime_category[gender])
VAR _label    = SELECTEDVALUE(dim_dem_crime_category[group_label])
VAR _offense  = SELECTEDVALUE(dim_offense_category[offense_label])

-- Resolve offense label to its metric slug in fact_crime_wi_county
VAR _offense_filter =
    SWITCH(
        _offense,
        "Aggravated Assault",                          "victim_aggravated_assault",
        "Intimidation",                                "victim_intimidation",
        "Simple Assault",                              "victim_simple_assault",
        "Justifiable Homicide",                        "victim_justifiable_homicide",
        "Murder and Nonnegligent Manslaughter",        "victim_murder_and_nonnegligent_manslaughter",
        "Negligent Manslaughter",                      "victim_negligent_manslaughter",
        "Kidnapping/Abduction",                        "victim_kidnapping_abduction",
        "All Other Larceny",                           "victim_all_other_larceny",
        "Pocket-picking",                              "victim_pocket_picking",
        "Purse-snatching",                             "victim_purse_snatching",
        "Shoplifting",                                 "victim_shoplifting",
        "Theft From Building",                         "victim_theft_from_building",
        "Theft From Coin-Operated Machine or Device",  "victim_theft_from_coin_operated_machine_or_device",
        "Theft From Motor Vehicle",                    "victim_theft_from_motor_vehicle",
        "Theft of Motor Vehicle Parts or Accessories", "victim_theft_of_motor_vehicle_parts_or_accessories",
        "Burglary/Breaking & Entering",                "victim_burglary_breaking_entering",
        "Counterfeiting/Forgery",                      "victim_counterfeiting_forgery",
        "Destruction/Damage/Vandalism of Property",    "victim_destruction_damage_vandalism_of_property",
        "Embezzlement",                                "victim_embezzlement",
        "Extortion/Blackmail",                         "victim_extortion_blackmail",
        "Motor Vehicle Theft",                         "victim_motor_vehicle_theft",
        "Robbery",                                     "victim_robbery",
        "Criminal Sexual Contact",                     "victim_criminal_sexual_contact",
        "Incest",                                      "victim_incest",
        "Rape",                                        "victim_rape",
        "Sexual Assault With An Object",               "victim_sexual_assault_with_an_object",
        "Sodomy",                                      "victim_sodomy",
        BLANK()
    )

RETURN
IF(
    ISBLANK(_offense_filter),
    BLANK(),
    SWITCH(
        TRUE(),

        -- Age Group breakdowns -------------------------------------------------
        _metric = "Age Group" && _gender = "Female",
            CALCULATE(
                SUM(fact_crime_wi_county[estimate]),
                fact_crime_wi_county[metric]  = _offense_filter,
                fact_crime_wi_county[vic_sex] = "F",
                fact_crime_wi_county[vic_age] = _label
            ),

        _metric = "Age Group" && _gender = "Male",
            CALCULATE(
                SUM(fact_crime_wi_county[estimate]),
                fact_crime_wi_county[metric]  = _offense_filter,
                fact_crime_wi_county[vic_sex] = "M",
                fact_crime_wi_county[vic_age] = _label
            ),

        -- Race breakdowns ------------------------------------------------------
        _metric = "Race" && _gender = "Female",
            CALCULATE(
                SUM(fact_crime_wi_county[estimate]),
                fact_crime_wi_county[metric]   = _offense_filter,
                fact_crime_wi_county[vic_sex]  = "F",
                fact_crime_wi_county[vic_race] = _label
            ),

        _metric = "Race" && _gender = "Male",
            CALCULATE(
                SUM(fact_crime_wi_county[estimate]),
                fact_crime_wi_county[metric]   = _offense_filter,
                fact_crime_wi_county[vic_sex]  = "M",
                fact_crime_wi_county[vic_race] = _label
            ),

        BLANK()
    )
)
